// OAuth clients of the bundled `idp` service. THIS FILE IS THE SOURCE OF TRUTH:
// at every start the idp validates it and reconciles it into the database under
// an advisory lock — missing clients are inserted, changed ones updated, and a
// client no longer listed here is DISABLED (its tokens and consents revoked), or
// deleted when `oauth.reconcile.prune` is true in config.jsonc. Dynamic client
// registration is off and the client CRUD endpoints are unreachable, so adding an
// application means adding it here and restarting the idp:
//
//   docker compose restart idp
//
// The same `${env:NAME}` / `${env:NAME:-default}` placeholders as config.jsonc
// work here, resolved from the `idp` service's environment in
// ../docker-compose.yml. The dokploy build EMBEDS this file into the generated
// compose — regenerate after every change (../build.sh).
//
// v1 supports the `authorization_code` (PKCE S256) and `refresh_token` grants
// only. There is no `client_credentials`: for scripted access, issue yourself a
// per-user API key at /idp/account/api-keys and exchange it for a JWT at
// GET /idp/api/auth/token with an `x-api-key` header.
{
  "clients": [
    {
      // The web app — the `web` service, served at the front door's root. A
      // public client: no secret, PKCE S256 required.
      //
      // The id must match VITE_OAUTH_CLIENT_ID on the `web` service; both
      // default to `public-client`.
      "clientId": "public-client",
      "name": "Semantius App",
      "type": "spa",

      // EXACT match, no wildcards. The SPA builds its redirect URI as
      // `${window.location.origin}/oauth2_callback`, so this has to be the
      // origin the browser actually uses — which is what PUBLIC_WEB_ORIGIN is
      // for (the Caddy front door, no path, no trailing slash). Going live, set
      // PUBLIC_WEB_ORIGIN=https://yourdomain.com in .env; add a second entry
      // here if the same deployment is reached on more than one origin.
      //
      // With server.dynamicIssuer on (config.jsonc), PUBLIC_WEB_ORIGIN may be
      // the TEMPLATE https://{host}: the idp substitutes the whole host of the
      // request being authorized, so every domain the edge routes gets a
      // matching redirect URI. `{host}` must stand for the entire host
      // component and `*` stays refused — this is not a wildcard. The Dokploy
      // variant ships exactly that value.
      "redirectUris": ["${env:PUBLIC_WEB_ORIGIN:-http://localhost:3000}/oauth2_callback"],

      // Where the idp may send the browser after an RP-initiated logout. Three
      // entries because the SPA has three exits: its /logout route calls the
      // end-session endpoint with no redirect at all, its OAuth library falls
      // back to the redirect URI when no logout redirect is configured, and a
      // plain return lands on the app root.
      "postLogoutRedirectUris": [
        "${env:PUBLIC_WEB_ORIGIN:-http://localhost:3000}/",
        "${env:PUBLIC_WEB_ORIGIN:-http://localhost:3000}/logout-success",
        "${env:PUBLIC_WEB_ORIGIN:-http://localhost:3000}/oauth2_callback"
      ],

      // Must be a subset of `oauth.scopes` in config.jsonc.
      "scopes": ["openid", "profile", "email", "offline_access"],

      // Needs at least one postLogoutRedirectUris entry, above.
      "enableEndSession": true
    },

    {
      // The `semantius-cli` command-line client. Public, PKCE S256 required —
      // a CLI on the user's machine cannot keep a secret.
      //
      // `native` rather than `spa`: that is the type for an application that
      // catches the authorization code on a loopback listener it starts itself
      // (RFC 8252), which is what the three redirect URIs below are.
      "clientId": "semantius-cli",
      "name": "Semantius CLI",
      "type": "native",

      // EXACT match, no wildcards — with one carve-out that applies here:
      // for a loopback IP (127.0.0.0/8, [::1]; NOT the name `localhost`) the
      // idp compares scheme, host, path and query and ignores the PORT, per
      // RFC 8252 §7.3. So the CLI may bind any port and still match, and the
      // three entries are the three it actually tries, in order, written out
      // so the registration reads as what the CLI does rather than relying on
      // the carve-out.
      "redirectUris": [
        "http://127.0.0.1:53682/callback",
        "http://127.0.0.1:53683/callback",
        "http://127.0.0.1:53684/callback"
      ],

      // Same set as the SPA. `offline_access` is what gets the CLI a refresh
      // token, so a signed-in terminal keeps working past the 15-minute
      // access-token TTL without reopening a browser.
      "scopes": ["openid", "profile", "email", "offline_access"],

      // A file-declared client defaults to `skipConsent: true` — an operator
      // wrote the entry down, so asking the user to approve an application
      // their own organization registered is a click that teaches them to
      // click. This one is explicit the other way. The CLI runs on the user's
      // own machine and asks for `offline_access`: a refresh token that keeps
      // a terminal signed in for 30 days, long past the browser window that
      // granted it. The consent screen is the one place that is said out loud,
      // and it names the scopes, so the click is a real question here.
      "skipConsent": false,

      // No browser to send anywhere after an RP-initiated logout, so no
      // postLogoutRedirectUris — and `enableEndSession` defaults to true and
      // refuses to start without one, hence the explicit false. The CLI logs
      // out by discarding its own tokens.
      "enableEndSession": false
    }
  ]
}
