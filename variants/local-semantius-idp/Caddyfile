# Front door for the semantius-rest stack. The `# >>> feature:<name>` /
# `# <<< feature:<name>` pairs below mark routes that belong to one optional
# part of the stack: a variant build that drops that part cuts the marked region
# out of its copy of this file, and Caddy never sees the markers either way.
#
# SITE_ADDRESS comes from the compose
# (default ":80" — plain HTTP; TLS terminated by Dokploy/Traefik or use a bare
# domain for Caddy auto-HTTPS on a bare VPS, then publish 80/443).
# Trust the X-Forwarded-* headers of whatever sits IN FRONT of this Caddy --
# and of nothing else, because whatever is trusted can forge the client
# address (rate-limit evasion, a false address in the idp's audit trail) and
# the forwarded host.
#
# Caddy ignores incoming X-Forwarded-* from a caller it does not trust and
# writes the caller's own address instead. Alone at the edge (the plain stack)
# that caller IS the browser and everything is right, so the default here
# trusts only the container's own loopback -- which nothing external can
# arrive from, i.e. nobody. Behind Dokploy's Traefik the caller is Traefik, and
# without trust every request reached the idp with Traefik's address: one
# rate-limit bucket shared by every user. The Dokploy template therefore sets
# TRUSTED_PROXIES=172.16.0.0/12 (Docker's default address pools, where Traefik
# lives); tighten it to dokploy-network's own subnet once you know it --
# `docker network inspect dokploy-network` -- so that only containers on
# Traefik's network are trusted. With it, X-Forwarded-For arrives at the idp
# as "client, traefik", and the idp's `server.trustProxy: true` takes the
# leftmost -- the client.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Bare /rest, /api-docs or /idp wouldn't match the /*-suffixed matchers below
	# and would fall through to the SPA — bounce to the canonical slash form
	# (redir sorts before handle/handle_path in Caddy's directive order; 308
	# keeps the method).
	redir /rest /rest/ 308
	redir /api-docs /api-docs/ 308
	redir /idp /idp/ 308

	# THE DOCS' Accept HEADER, collapsed to plain JSON.
	#
	# Scalar builds "Test Request" headers by joining EVERY response content type
	# the document declares for the first 2xx response, and PostgREST declares four
	# of them GLOBALLY (`produces`), so every operation inherits all four and the
	# docs send:
	#
	#   Accept: application/json, application/vnd.pgrst.object+json;nulls=stripped,
	#           application/vnd.pgrst.object+json, text/csv
	#
	# PostgREST then picks the SINGULAR `vnd.pgrst.object+json` out of that list —
	# not the `application/json` listed first — and every multi-row endpoint answers
	# `406 PGRST116 Cannot coerce the result to a single JSON object`. Neither end
	# can be configured out of it: PostgREST has no setting for `produces`, and
	# Scalar has none for the Accept header. So it is collapsed here.
	#
	# The matcher is the exact machine-generated PREFIX, and that precision is the
	# point: a caller who genuinely wants one object sends
	# `application/vnd.pgrst.object+json` ALONE and never matches, so single-object
	# requests keep working — including their PGRST116 when the result really is not
	# a single row.
	@pgrstDocsAccept header Accept "application/json, application/vnd.pgrst.object+json*"
	request_header @pgrstDocsAccept Accept application/json

	# --- the document's own origin -------------------------------------------
	# /.well-known/semantius.json publishes ABSOLUTE urls, like every other
	# document under /.well-known/ (OIDC discovery, RFC 8414, RFC 9728) — a client
	# should not have to resolve them against anything. They are derived from the
	# ARRIVING REQUEST rather than configured, so the deployment stays
	# domain-agnostic: attach a domain after deploy and the document follows it,
	# with no env to edit. Same approach as the idp's IDP_DYNAMIC_ISSUER.
	#
	# The scheme MUST come from X-Forwarded-Proto when there is one.
	# {http.request.scheme} describes the hop that reached THIS Caddy, and under
	# Dokploy/Traefik that hop is plain HTTP because TLS is terminated in front —
	# so using it alone publishes http:// urls for an https:// deployment. Caddy
	# does not fold X-Forwarded-Proto into that placeholder (not even for a
	# trusted_proxies peer), hence this map.
	#
	# The host comes from the request's own Host (via hostport, so local dev keeps
	# its :3000) and NOT from X-Forwarded-Host: Traefik forwards the original Host
	# anyway, and reading one forwarded header instead of two keeps the trusted
	# surface smaller.
	map {http.request.header.X-Forwarded-Proto} {pscheme} {
		~^(.+)$  "${1}"
		default  "{http.request.scheme}"
	}

	# VITE_OAUTH_CONFIG may be either form: RELATIVE for the bundled idp (the
	# default, so it follows the host) or ABSOLUTE for an external issuer, which
	# is Entra's own login.microsoftonline.com url and must be published
	# untouched. So prefix it only when it is not already absolute.
	#
	# Two Caddy details this shape exists to dodge: the env value cannot be the
	# `map` SOURCE directly, because a leading `/` is consumed as a path matcher
	# ("missing destination argument(s)" at startup) — hence `vars` first; and a
	# regex branch expands ${1} capture groups but NOT placeholders, so the
	# passthrough has to capture the value rather than name the variable again.
	vars idp_wk_raw "{$VITE_OAUTH_CONFIG}"
	map {vars.idp_wk_raw} {idp_wk} {
		~^(https?://.*)$  "${1}"
		default           "{pscheme}://{http.request.hostport}{vars.idp_wk_raw}"
	}

	# --- platform discovery: /.well-known/semantius.json ----------------------
	#
	# ONE document that tells semantius-cli everything it needs to sign in and
	# call the API: the OIDC discovery URL, the CLI's client id, the loopback
	# URIs that client id has registered, the API scope and the audience. Plain
	# OIDC discovery cannot carry the last two — see README.md.
	#
	# OUTSIDE the bundled-idp markers ON PURPOSE. Everything else under
	# /.well-known/ below belongs to the idp and is cut with it; this route has
	# to survive in the Entra variant, which is exactly where a CLI cannot
	# guess. Caddy sorts `handle` blocks by matcher specificity, so this exact
	# path wins over the general /.well-known/* proxy regardless of the order
	# here.
	#
	# The body is a BACKTICK-quoted string: `{$VAR}` is substituted by the
	# Caddyfile lexer, and the JSON's own braces survive to the response because
	# `respond` replaces only placeholders it recognises and leaves the rest
	# verbatim. Caddy sets Content-Type: application/json itself — it sniffs the
	# leading brace — and this route answers any method, not only GET.
	#
	# Every {$VAR} comes from the caddy service's `environment:` in
	# ../docker-compose.yml. Caddy reads its OWN process environment, so a value
	# that is only in .env renders as "" and the document lies QUIETLY. Add a
	# field here and its variable there in the same edit.
	#
	# `redirect_uris` stays absolute-as-written: those point at the USER's own
	# machine, not at this deployment, so they are never derived from the request.
	#
	# `redirect_uris` is a LITERAL, and must match what is actually registered
	# for the client: semantius-idp-config/oauth_clients.jsonc for the bundled
	# idp, setup-entra.ps1 for the Entra variant. Change them there, change them
	# here. (The bundled idp ignores the PORT for a loopback IP per RFC 8252
	# §7.3, so the list is descriptive for it; Entra matches the port and there
	# it is binding.)
	#
	# api_url STAYS LAST: gateway_url above it is cut line-by-line in the Entra
	# variant, and a surviving field after it is what keeps the JSON
	# comma-correct. Do not reorder those two.
	handle /.well-known/semantius.json {
		respond `{
	"version": 1,
	"host_type": "selfhost",
	"idp_type": "{$SEMANTIUS_IDP_TYPE}",
	"idp_well_known": "{idp_wk}",
	"client_id_cli": "{$CLI_OAUTH_CLIENT_ID}",
	"redirect_uris": ["http://127.0.0.1:53682/callback", "http://127.0.0.1:53683/callback", "http://127.0.0.1:53684/callback"],
	"scope": "{$VITE_OAUTH_SCOPE}",
	"audience": "{$VITE_OAUTH_AUDIENCE}",
	"gateway_url": "{pscheme}://{http.request.hostport}/gateway/rest",
	"api_url": "{pscheme}://{http.request.hostport}/rest"
}
` 200
	}

	# /gateway/<name> is the idp's authenticating reverse proxy. It lives at
	# /idp/gateway upstream, like the rest of the app; this serves it at the
	# short root-level form instead.
	#
	# A `rewrite`, so the caller's URL stays /gateway — and that is only correct
	# because the idp's session cookie is scoped to the WHOLE HOST. It was
	# scoped to /idp until the idp's **D97**, and under that scoping this had to
	# be a 308 to /idp/gateway: a rewrite would have kept the caller outside the
	# cookie's Path, the browser would have stopped attaching the session, and
	# the proxy treats a missing session as ANONYMOUS rather than as a refusal
	# (`sessionCredential`, server/gateways/proxy.ts) — so cookie-authenticated
	# calls would have quietly downgraded instead of failing.
	#
	# If `server.cookiePath` is ever narrowed back to /idp in semantius-idp-config, this
	# block has to go back to being a redirect, or come out.
	handle /gateway* {
		rewrite * /idp{uri}
		reverse_proxy idp:3000
	}

	# PostgREST, and there are TWO ways in. THIS one is direct: the prefix is
	# stripped and the request reaches the API with whatever `Authorization` the
	# caller sent, or none. It is the web app's path (VITE_API_BASE_URL=/rest)
	# and the one to curl a bearer token against.
	#
	# The other is /gateway/rest above — the idp's authenticating proxy in front of
	# the SAME upstream, which additionally exchanges an `x-api-key` for a bearer
	# token. That is the one the OpenAPI spec advertises and the Scalar docs call
	# (PGRST_OPENAPI_SERVER_PROXY_URI / PUBLIC_API_URL), so "Test Request" works
	# with an API key and not only with a hand-minted JWT.
	handle_path /rest/* {
		reverse_proxy postgrest:3000
	}
	handle_path /api-docs/* {
		reverse_proxy scalar:8080
	}

	# --- the identity provider ----------------------------------------------
	#
	# Two rules, and both are easy to get wrong in ways that fail quietly.
	#
	# 1. The idp is served at /idp WITHOUT stripping the prefix — `handle`, never
	#    `handle_path`. Its `server.baseUrl` carries /idp and it renders every
	#    link, cookie Path, e-mail URL and redirect from that value; strip the
	#    prefix here and all of them point one level too high, so sign-in appears
	#    to work while the session cookie is set on a path the browser never
	#    sends back.
	#
	# 2. The discovery documents are served from the ORIGIN ROOT, which belongs to
	#    the SPA. A client handed the issuer `<origin>/idp` does NOT fetch
	#    `{issuer}/.well-known/...`: RFC 8414 §3.1 inserts the well-known segment
	#    BETWEEN the host and the path, so it asks for
	#    `<origin>/.well-known/oauth-authorization-server/idp`. Both spellings of
	#    the suffix form are routed below, plus the plain `/.well-known/*` root
	#    form that this stack's own SPA and jwks tooling use. Nothing does this
	#    for you, and the symptom is a client that cannot discover an idp which is
	#    otherwise working perfectly.
	#
	# Caddy sorts `handle` blocks by matcher specificity, so the two suffix forms
	# win over the general /.well-known/* below regardless of the order here.
	handle /.well-known/oauth-authorization-server/idp* {
		rewrite * /idp/.well-known/oauth-authorization-server
		reverse_proxy idp:3000
	}
	handle /.well-known/openid-configuration/idp* {
		rewrite * /idp/.well-known/openid-configuration
		reverse_proxy idp:3000
	}
	# The root form: /.well-known/openid-configuration, /.well-known/jwks.json and
	# anything else the idp publishes there, re-prefixed onto its mount path.
	handle /.well-known/* {
		rewrite * /idp{uri}
		reverse_proxy idp:3000
	}
	handle /idp/* {
		reverse_proxy idp:3000
	}

	handle {
		reverse_proxy nginx:80
	}
}
